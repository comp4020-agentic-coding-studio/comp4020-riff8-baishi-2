---
import { marked } from "marked";
import readmeSource from "../../README.md?raw";
import "../styles/global.css";

const body = marked.parse(readmeSource, { async: false }) as string;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About &mdash; The Scroll</title>
    <meta
      name="description"
      content="What good means for The Scroll, and what's enforced versus judged."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="masthead">
      <p class="back"><a href="/">&larr; back to the scroll</a></p>
    </header>
    <main class="page-paper" set:html={body} />
  </body>
</html>

<style>
  .back {
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }
  .page-paper :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--wet);
  }
</style>
